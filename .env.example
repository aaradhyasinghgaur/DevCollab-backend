# ========================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or paste into Render / Railway / Cloud Provider
# ========================================================

# Server Port (Render and Railway inject this automatically)
PORT=8080

# Database Configuration (PostgreSQL)
# e.g. on Render/Neon/Supabase: jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/devcollab
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Decoupled Frontend URL (MUST point to your deployed frontend domain)
# Used for redirecting after successful OAuth2 Google/GitHub login
APP_FRONTEND_URL=https://your-frontend.vercel.app

# CORS Allowed Origins (Comma-separated URLs of allowed client frontends)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:5173

# OAuth2 Authentication Providers
# (Obtain these from Google Cloud Console & GitHub Developer Settings)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional Redis Configuration (if using Redis for multi-instance presence)
# Leave as localhost or empty if running single-instance (Presence falls back to in-memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
