# ========================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or paste into Render / Railway / Cloud Provider
# ========================================================

# Server Port (Render and Railway inject this automatically, defaults to 8080)
PORT=8080

# Database Configuration (PostgreSQL)
# On Render: Auto-injected as DATABASE_URL when deploying via render.yaml Blueprint.
# When creating manually on Render: Copy the "Internal Database URL" (e.g. postgresql://devcollab:pass@dpg-xxx-a/devcollab)
# You can supply either DATABASE_URL or SPRING_DATASOURCE_URL:
DATABASE_URL=postgresql://devcollab:your_password@localhost:5432/devcollab

# Alternatively, manual JDBC URL & Credentials:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/devcollab
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_database_password

# Decoupled Frontend URL (MUST point to your deployed frontend domain)
# Used for redirecting after successful OAuth2 Google/GitHub login
APP_FRONTEND_URL=https://your-frontend.vercel.app

# CORS Allowed Origins (Comma-separated URLs of allowed client frontends)
APP_CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://your-frontend.vercel.app,http://localhost:3000,http://localhost:5173

# OAuth2 Authentication Providers
# (Obtain these from Google Cloud Console & GitHub Developer Settings)
# Render OAuth Callback URLs to register in Google / GitHub:
# - Google: https://<your-render-service>.onrender.com/login/oauth2/code/google
# - GitHub: https://<your-render-service>.onrender.com/login/oauth2/code/github
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional Redis Configuration
# If using Upstash Redis or external Redis, paste REDIS_URL (supports rediss:// TLS):
# REDIS_URL=rediss://default:token@your-redis.upstash.io:6379
# If omitted or not provided, presence automatically falls back to in-memory tracking!
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
